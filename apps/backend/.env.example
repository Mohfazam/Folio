# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Server
PORT=4000
NODE_ENV=development

# Service URLs
CALLING_SERVICE_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:4000
ALLOWED_ORIGINS=*

# Machine-to-Machine
WEBHOOK_SECRET=
BACKEND_WORKER_SECRET=

# Supabase Auth
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# -------------------------------------------------------------
# SMTP Email Configuration (Nodemailer)
# -------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false

# Auth sender (OTP emails sent from auth@foolioo.app)
SMTP_AUTH_USER=auth@foolioo.app
SMTP_AUTH_PASS=your-auth-password
AUTH_EMAIL_FROM="Foolioo Auth" <auth@foolioo.app>

# Support sender (Support tickets & OTPs sent from support@foolioo.app)
SMTP_SUPPORT_USER=support@foolioo.app
SMTP_SUPPORT_PASS=your-support-password
SUPPORT_EMAIL_FROM="Foolioo Support" <support@foolioo.app>

# Optional fallback credentials (if using a single SMTP account)
# SMTP_USER=
# SMTP_PASS=
