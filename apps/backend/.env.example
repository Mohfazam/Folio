# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Server
PORT=4000
NODE_ENV=development

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_PLAN_ID_GROWTH=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_SCALE=

# Service URLs
CALLING_SERVICE_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://foolioo.app,https://www.foolioo.app

# Machine-to-Machine
WEBHOOK_SECRET=
CALLING_SERVICE_SECRET=
BACKEND_WORKER_SECRET=

# Supabase Auth
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# -------------------------------------------------------------
# SMTP Email Configuration (Nodemailer)
# -------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false

# Auth sender (OTP emails sent from auth@foolioo.app)
SMTP_AUTH_USER=auth@foolioo.app
SMTP_AUTH_PASS=your-auth-password
AUTH_EMAIL_FROM="Foolioo Auth" <auth@foolioo.app>

# Support sender (Support tickets & OTPs sent from support@foolioo.app)
SMTP_SUPPORT_USER=support@foolioo.app
SMTP_SUPPORT_PASS=your-support-password
SUPPORT_EMAIL_FROM="Foolioo Support" <support@foolioo.app>
