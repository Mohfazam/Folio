{
  "name": "@repo/backend",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "test": "tsx --test \"test/**/*.test.ts\"",
