    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.4.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
