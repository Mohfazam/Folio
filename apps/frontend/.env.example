# Public (exposed to browser) vars must start with NEXT_PUBLIC_
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
UPSTASH_REDIS_REST_URL=your_url_here
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Server-side only. Set this to the origin where apps/backend Express listens.
# Do not add NEXT_PUBLIC_ to this variable.
BACKEND_API_URL=http://localhost:<YOUR_BACKEND_PORT>

# Optional: used when the request Origin header is unavailable for Supabase email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Public live-demo integration. Keep TURNSTILE_SECRET_KEY server-only.
NEXT_PUBLIC_PUBLIC_DEMO_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PUBLIC_DEMO_API_URL=
